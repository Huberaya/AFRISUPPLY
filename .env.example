# ---- Base de données (Neon) ----
# Chaîne de connexion Neon (pooler recommandé). Laisser vide en local → PGlite embarqué.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/afrisupply?sslmode=require

# ---- API ----
PORT=8787
# Obligatoire en production, 32 caractères minimum. Générer : openssl rand -hex 32
# (le serveur refuse de démarrer en production avec un secret vide, court ou de développement)
JWT_SECRET=
NODE_ENV=development
AUTO_MIGRATE=true        # applique les migrations au démarrage
# Chantier 2 : désactivé par défaut. Le restaurant de démonstration (awa@chezawa.fr / demo1234)
# ne doit exister que sur un environnement local ou une démo volontairement publique.
# En production, il faut en plus ALLOW_DEMO_SEED=true, sinon le seed est refusé.
SEED_DEMO=false
ALLOW_DEMO_SEED=false
# Durée de vie des sessions (7d par défaut). Toute session est révocable :
# changement de mot de passe ou « déconnecter tous mes appareils ».
AUTH_TOKEN_TTL=7d
# Politique de mot de passe et durée des liens de réinitialisation
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TTL_MINUTES=60
# CORS : liste blanche des origines autorisées (séparées par des virgules).
# En production, le site et l'API partagent le même domaine : laisser vide suffit.
# Ne mettre JAMAIS « * » : les cookies de session circulent avec les requêtes.
ALLOWED_ORIGINS=
# true uniquement si l'API tourne derrière un reverse proxy de confiance (Vercel le fait automatiquement)
TRUST_PROXY=

# ---- Web (Vite) ----
API_URL=http://localhost:8787   # cible du proxy /api en dev

# Assistant IA (optionnel, API compatible OpenAI) — sans clé : moteur local uniquement
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini   # lecture de factures (chantier 9) — modèle avec vision

# ---- Sauvegarde hors site (chantier 13) ----
# Les sauvegardes sont écrites sur le disque local PUIS envoyées vers un stockage externe compatible
# S3 (Cloudflare R2, Backblaze B2, Scaleway, AWS S3, MinIO…). En serverless, le disque est éphémère :
# sans copie externe, une sauvegarde disparaît avec l'instance qui l'a produite.
# Chaque copie est RELUE après envoi et son empreinte SHA-256 comparée ; l'essai de restauration
# (POST /api/admin/backups/offsite-drill) part de la copie EXTERNE et la recharge dans une base neuve.
# Sans configuration : l'API le dit explicitement (variables manquantes nommées), rien n'est simulé.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Facultatif : région (« auto » pour R2/Scaleway), style d'URL, préfixe, nombre de copies gardées
BACKUP_S3_REGION=auto
BACKUP_S3_STYLE=path
BACKUP_S3_PREFIX=afrisupply/backups
BACKUP_OFFSITE_KEEP=14


# Admin léger (liste des leads du site) : e-mails séparés par des virgules
ADMIN_EMAILS=hubertbay@gmail.com

# Job quotidien (chantier 4 bis) — POST /api/jobs/daily avec le header X-Cron-Secret
CRON_SECRET=change-me
APP_URL=http://localhost:3000
# E-mail : Resend si RESEND_API_KEY, sinon les mails sont écrits dans MAIL_OUTBOX_DIR (dev)
RESEND_API_KEY=
MAIL_FROM=AFRISUPPLY <bonjour@afrisupply.fr>
MAIL_OUTBOX_DIR=.outbox

# ---- Exploitation (chantier 8) ----
SENTRY_DSN=                 # API : remontée des erreurs 500 + échecs du job du matin (sentry.io, projet Node)
VITE_SENTRY_DSN=            # Web : erreurs JavaScript (projet Browser) — préfixe VITE_ obligatoire
SKIP_MIGRATE=0              # 1 pour ne pas migrer au build Vercel

# Chantier 10 : activer d'office les fournisseurs plateforme (dev/démo). En prod : validation via /app/admin/fournisseurs
VENDOR_AUTO_APPROVE=false

# Chantier 6 : facturation Stripe (abonnements restaurants + commissions fournisseurs)
STRIPE_SECRET_KEY=            # sk_live_… / sk_test_… — si vide : pas de paiement en ligne, checkout → message « écrivez-nous »
STRIPE_WEBHOOK_SECRET=        # whsec_… (endpoint POST /api/billing/webhook)
STRIPE_PRICE_STARTER=         # price_… (39 €/mois)
STRIPE_PRICE_PRO=             # price_… (89 €/mois)
STRIPE_PRICE_BUSINESS=        # price_… (199 €/mois)
STRIPE_COUPON_FOUNDER=        # coupon −50 % « forever » appliqué aux restaurants pilotes fondateurs
# Chantier 25 : le paiement en ligne des commandes (Stripe Connect Express) s'active dès que STRIPE_SECRET_KEY est définie et Connect activé côté Stripe.
BILLING_ENFORCE=              # true = essai expiré → lecture seule + fonctions par formule ; défaut : actif dès que STRIPE_SECRET_KEY est définie

# Chantier 18 — WhatsApp / SMS (Twilio). Vides = journalisation seule.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
REMINDER_HOURS=4
