# ---- Base de données (Neon) ----
# Chaîne de connexion Neon (pooler recommandé). Laisser vide en local → PGlite embarqué.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/afrisupply?sslmode=require

# ---- API ----
PORT=8787
JWT_SECRET=changez-moi-64-caracteres-aleatoires
NODE_ENV=development
AUTO_MIGRATE=true        # applique les migrations au démarrage
SEED_DEMO=true           # crée le restaurant démo « Chez Awa » (awa@chezawa.fr / demo1234)

# ---- Web (Vite) ----
API_URL=http://localhost:8787   # cible du proxy /api en dev
